# stock_research — 평문 시크릿/운영 산출물 보호
# (현재 git 저장소가 아니지만, 나중에 git init 하더라도 키가 커밋되지 않도록 미리 차단)

# 평문 키/계정 (절대 커밋 금지)
*.txt
!requirements.txt
*.full
gmail_credentials.json
gmail_token.json

# 런타임/산출물
output/
logs/
collection_check/
cache/
precollect/
# retro_reports/ — 2026-09-09 부터 추적한다(특기입증자료 증빙).
#   회차당 1개씩 쌓이고 한번 쓰면 바뀌지 않는 파일이라 매일 갱신되는 산출물과 성격이 다르다.
#   실측 스캔 결과 실제 이메일·토큰·개인 보유 정보 0건(38개 파일).
_backup/
_retired/
__pycache__/
*.pyc
*.flag
*.lock
supervisor_state.json
supervisor_heartbeat.txt
