# stock_research — 평문 시크릿/운영 산출물 보호
# (현재 git 저장소가 아니지만, 나중에 git init 하더라도 키가 커밋되지 않도록 미리 차단)

# 평문 키/계정 (절대 커밋 금지)
*.txt
!requirements.txt
*.full
gmail_credentials.json
gmail_token.json

# 런타임/산출물
output/
logs/
collection_check/
cache/
precollect/
retro_reports/
_backup/
_retired/
__pycache__/
*.pyc
*.flag
*.lock
supervisor_state.json
supervisor_heartbeat.txt
sent_index.json
sent_index.json.bak_*
krx_tickers.json

# 생성 데이터(수집기/파이프라인 산출물) — 코드 저장소엔 불필요
*.json
*.csv
scorecard.md
retro_feedback.md

# 에디터/도구
.claude/
.vscode/
.idea/
tmp_cap/

# Apps Script 사본(.gs) — 실배포본에는 SECRET_TOKEN 이 평문으로 들어간다(v11.6 감사).
# 저장소에는 플레이스홀더 템플릿(mail_webapp.gs — 이미 추적 중이라 이 규칙 영향 없음)만 두고,
# 시크릿을 채운 사본(code.gs 등)이 git add . 로 우발 유입되는 것을 차단한다.
*.gs

# ===== 개인 보유 정보 (v11.12) =====
# portfolio.csv 는 *.csv 전역 규칙(32행)이 이미 막는다. 아래는 json 산출본만 추가.
portfolio_review.json

# --normalize 가 만드는 백업. 원본이 보유 내역이라 그대로 개인정보다.
*.bak
