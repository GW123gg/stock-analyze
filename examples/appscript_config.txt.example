# appscript_config.txt
# Apps Script 웹앱 주소와 비밀키
#
# 이 파일은 **양식**입니다. 값이 비어 있습니다.
#   1) 이 파일을 같은 폴더에 appscript_config.txt 라는 이름으로 복사하세요.
#   2) = 오른쪽에 본인 값을 채우세요.
#   3) appscript_config.txt 는 .gitignore 로 막혀 있어 저장소에 올라가지 않습니다.
#
# ── 원본에 있던 설명 ──
# ======================================================================
#  appscript_config.txt — Apps Script 메일 발송 웹앱 설정
# ----------------------------------------------------------------------
#  appscript_secret : Apps Script 코드(mail_webapp.gs)의 SECRET_TOKEN 과
#                     "똑같은 값"이어야 합니다. (아래에 미리 채워둠)
#  appscript_url    : 웹앱 배포 후 받은 URL. 배포 전까지는 비워둡니다
#                     (URL 이 비어 있으면 supervisor 가 메일을 보내지 않습니다 — 안전).
#
#  [배포 후 할 일]
#    1) 아래 'appscript_url =' 줄 맨 앞의 #(주석) 을 지운다
#    2) = 뒤에 복사한 웹앱 URL 을 붙여넣는다
#    3) 저장 → supervisor 가 25초 내 자동 감지해 발송을 켭니다 (재시작 불필요)
# ======================================================================
# 배포 후 이 줄의 맨 앞 # 를 지우고 URL 을 붙여넣으세요:
#
appscript_url = 
appscript_secret = 
