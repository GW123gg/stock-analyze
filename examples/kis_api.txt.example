# kis_api.txt
# 한국투자증권 OpenAPI 앱키/시크릿
#
# 이 파일은 **양식**입니다. 값이 비어 있습니다.
#   1) 이 파일을 같은 폴더에 kis_api.txt 라는 이름으로 복사하세요.
#   2) = 오른쪽에 본인 값을 채우세요.
#   3) kis_api.txt 는 .gitignore 로 막혀 있어 저장소에 올라가지 않습니다.
#
# ── 원본에 있던 설명 ──
# ======================================================================
#  kis_api.txt — 한국투자증권(KIS) Open API 인증 (KIS Developers)
# ----------------------------------------------------------------------
#  키를 넣으면 kis_collect.py 가 KIS REST API 로 '수급(외국인/기관/개인 순매수)'
#  + 시세(현재가·등락·외국인보유율) 등 다양한 자료를 수집한다.
#  (키가 비어 있으면 아무것도 안 하고 조용히 넘어간다 — 지금처럼 키 없어도 안전.)
#
#  [발급] https://apiportal.koreainvestment.com  →  회원가입  →  'KIS Developers' 앱 등록
#         → APP KEY / APP SECRET 발급 (실거래 계좌 또는 '모의투자' 신청 후)
#
#  형식: 아래 KEY = VALUE 의 값만 채우고 저장. (# 으로 시작하는 줄은 주석)
#        저장하면 다음 수집부터 자동 반영(재시작 불필요).
#  주의: 외부 공유/업로드 금지(개인 인증키).
# ======================================================================
# 거래 모드:  real = 실거래(openapi:9443),  mock = 모의투자(openapivts:29443)
# 발급받은 APP KEY / APP SECRET  (값만 붙여넣기)
# (선택) 계좌번호 — 잔고/주문에 필요. 수급·시세 '조회'만 할 거면 비워둬도 됨.
#   형식 예: 50012345-01
#
mode = 
appkey = 
appsecret = 
account = 
